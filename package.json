{
  "name": "mmf-blog-api-koa2-ts",
  "version": "3.0.0",
  "packageManager": "pnpm@10.18.3",
  "description": "mmf blog api server",
  "author": "lincenying &lt;lincenying@qq.com&gt;",
  "license": "MIT",
  "engines": {
    "node": ">= 16.0.0",
    "npm": ">= 8.0.0"
  },
  "scripts": {
    "hooks": "npx simple-git-hooks",
    "tsc": "tsc",
    "init:config": "tsx src/init.ts",
    "build": "npm run init:config && npm run tsc",
    "deploy": "node dist/app.js",
    "deploy-watch": "nodemon --delay 500ms --watch ./dist dist/app.js",
    "serve": "nodemon --watch ./src --exec esno ./src/app.ts",
    "start": "npm run deploy",
    "lint": "eslint . --flag unstable_ts_config",
    "lint:fix": "eslint . --flag unstable_ts_config --fix",
    "lint:ts": "tsc --noEmit"
  },
  "dependencies": {
    "@koa/multer": "^4.0.0",
    "@koa/router": "^14.0.0",
    "@ladjs/koa-views": "^9.0.0",
    "@lincy/multer": "^3.0.2",
    "@lincy/utils": "^0.7.0",
    "axios": "^1.12.2",
    "baidu-aip-sdk": "^4.16.16",
    "base64-img": "^1.0.4",
    "cheerio": "1.0.0",
    "dayjs": "^1.11.18",
    "highlight.js": "^11.11.1",
    "jsonwebtoken": "^9.0.2",
    "koa": "^3.0.3",
    "koa-bodyparser": "^4.4.1",
    "koa-convert": "^2.0.0",
    "koa-json": "^2.0.2",
    "koa-logger": "^4.0.0",
    "koa-onerror": "^5.0.1",
    "koa-static": "^5.0.0",
    "lru-cache": "^11.2.2",
    "markdown-it": "^14.1.0",
    "markdown-it-toc-and-anchor": "^4.2.0",
    "md5": "^2.3.0",
    "mockjs": "^1.1.0",
    "moment": "^2.30.1",
    "mongoose": "^8.19.1",
    "mongoose-autopopulate": "^1.1.0",
    "multer": "1.4.5-lts.1",
    "qiniu": "^7.14.0",
    "tslib": "^2.8.1",
    "twig": "^1.17.1"
  },
  "devDependencies": {
    "@lincy/eslint-config": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/koa": "^3.0.0",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/koa-convert": "^1.2.7",
    "@types/koa-json": "^2.0.23",
    "@types/koa-logger": "^3.1.5",
    "@types/koa-static": "^4.0.4",
    "@types/koa__multer": "^2.0.7",
    "@types/koa__router": "^12.0.4",
    "@types/lincy__multer": "npm:@types/koa__multer@2.0.7",
    "@types/markdown-it": "^14.1.2",
    "@types/md5": "^2.3.6",
    "@types/mockjs": "^1.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.8.1",
    "@types/serve-favicon": "^2.5.7",
    "eslint": "^9.38.0",
    "esno": "^4.8.0",
    "jiti": "^2.6.1",
    "lint-staged": "^16.2.4",
    "nodemon": "^3.1.10",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "prettier"
      ]
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "simple-git-hooks[-del]": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged[-del]": {
    "*.{ts,js}": [
      "eslint --flag unstable_ts_config --fix"
    ]
  }
}
